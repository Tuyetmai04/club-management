# Application Port
APP_PORT=8080

# Nginx Reverse Proxy Ports (tránh xung đột với các cổng của Windows)
NGINX_PORT=8081
NGINX_SSL_PORT=8443

# phpMyAdmin Port
PHPMYADMIN_PORT=8082

# MySQL Database Configuration cho Docker Compose
MYSQL_PORT=3307
MYSQL_DATABASE=club_db
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=club_user
MYSQL_PASSWORD=your_club_user_password

# Monitoring Configuration (Prometheus, Grafana, cAdvisor)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8083
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password

# Centralized Logging Configuration (Loki, Promtail)
LOKI_PORT=3100
PROMTAIL_PORT=9080
